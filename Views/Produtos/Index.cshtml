@model IEnumerable<Produto>

<h2>Lista de Produtos</h2>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" value="@Context.Request.Query["search"]" class="form-control"
            placeholder="Pesquisar produto..." />
        <button class="btn btn-primary">Buscar</button>
    </div>
</form>

<a asp-action="Create" class="btn btn-success mb-3">+ Novo Produto</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Nome</th>
            <th>Preço</th>
            <th>Estoque</th>
            <th style="width: 220px;">Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>
                <td>@item.Preco</td>
                <td>@item.Estoque</td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>